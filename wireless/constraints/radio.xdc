# Board pins and educational DDR timing from exp2/lt_zynq_V200.xdc
create_clock -period 10.000 -name PL_CLK_100MHz [get_ports PL_CLK_100MHz]
set_property PACKAGE_PIN M19 [get_ports PL_CLK_100MHz]
set_property IOSTANDARD LVCMOS33 [get_ports PL_CLK_100MHz]
set_property PACKAGE_PIN L22  [get_ports GPIO_TH1]
set_property PACKAGE_PIN AA12 [get_ports GPIO_TH2]
set_property PACKAGE_PIN AB12 [get_ports GPIO_TH3]
set_property PACKAGE_PIN D21  [get_ports GPIO_TH4]
set_property IOSTANDARD LVCMOS33 [get_ports GPIO_TH1]
set_property IOSTANDARD LVCMOS33 [get_ports GPIO_TH2]
set_property IOSTANDARD LVCMOS33 [get_ports GPIO_TH3]
set_property IOSTANDARD LVCMOS33 [get_ports GPIO_TH4]
set_property PACKAGE_PIN AB19 [get_ports {AD9361_P0_D[11]}]
set_property PACKAGE_PIN AB20 [get_ports {AD9361_P0_D[10]}]
set_property PACKAGE_PIN AB21 [get_ports {AD9361_P0_D[9]}]
set_property PACKAGE_PIN AA21 [get_ports {AD9361_P0_D[8]}]
set_property PACKAGE_PIN AB22 [get_ports {AD9361_P0_D[7]}]
set_property PACKAGE_PIN AA22 [get_ports {AD9361_P0_D[6]}]
set_property PACKAGE_PIN Y20 [get_ports {AD9361_P0_D[5]}]
set_property PACKAGE_PIN Y21 [get_ports {AD9361_P0_D[4]}]
set_property PACKAGE_PIN W22 [get_ports {AD9361_P0_D[3]}]
set_property PACKAGE_PIN V22 [get_ports {AD9361_P0_D[2]}]
set_property PACKAGE_PIN U22 [get_ports {AD9361_P0_D[1]}]
set_property PACKAGE_PIN T22 [get_ports {AD9361_P0_D[0]}]
set_property PACKAGE_PIN AB14 [get_ports {AD9361_P1_D[11]}]
set_property PACKAGE_PIN AB15 [get_ports {AD9361_P1_D[10]}]
set_property PACKAGE_PIN Y13 [get_ports {AD9361_P1_D[9]}]
set_property PACKAGE_PIN AA13 [get_ports {AD9361_P1_D[8]}]
set_property PACKAGE_PIN Y14 [get_ports {AD9361_P1_D[7]}]
set_property PACKAGE_PIN AA14 [get_ports {AD9361_P1_D[6]}]
set_property PACKAGE_PIN Y15 [get_ports {AD9361_P1_D[5]}]
set_property PACKAGE_PIN W15 [get_ports {AD9361_P1_D[4]}]
set_property PACKAGE_PIN AB16 [get_ports {AD9361_P1_D[3]}]
set_property PACKAGE_PIN AA16 [get_ports {AD9361_P1_D[2]}]
set_property PACKAGE_PIN AA19 [get_ports {AD9361_P1_D[1]}]
set_property PACKAGE_PIN Y19 [get_ports {AD9361_P1_D[0]}]
set_property PACKAGE_PIN AA17 [get_ports AD9361_TX_FRAME]
set_property PACKAGE_PIN U17 [get_ports AD9361_RX_FRAME]
set_property PACKAGE_PIN W16 [get_ports AD9361_FBCLK]
set_property PACKAGE_PIN W17 [get_ports AD9361_DATACLK]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[11]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[10]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[9]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[8]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[7]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[6]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[5]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[4]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[3]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[2]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[1]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P0_D[0]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[11]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[10]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[9]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[8]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[7]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[6]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[5]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[4]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[3]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[2]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[1]}]
set_property IOSTANDARD LVCMOS18 [get_ports {AD9361_P1_D[0]}]
set_property IOSTANDARD LVCMOS18 [get_ports AD9361_TX_FRAME]
set_property IOSTANDARD LVCMOS18 [get_ports AD9361_RX_FRAME]
set_property IOSTANDARD LVCMOS18 [get_ports AD9361_FBCLK]
set_property IOSTANDARD LVCMOS18 [get_ports AD9361_DATACLK]
create_clock -period 122.0703125 -name AD9361_DATACLK [get_ports AD9361_DATACLK]
create_generated_clock -name clk2AD9361 -source [get_ports AD9361_DATACLK] -divide_by 1 [get_ports AD9361_FBCLK]
create_clock -name RX_LAUNCH -period 122.0703125
set_input_delay 0.500 -max -clock RX_LAUNCH [get_ports {AD9361_P0_D[*]}]
set_input_delay -0.500 -min -clock RX_LAUNCH [get_ports {AD9361_P0_D[*]}]
set_input_delay 0.500 -max -clock RX_LAUNCH -clock_fall -add_delay [get_ports {AD9361_P0_D[*]}]
set_input_delay -0.500 -min -clock RX_LAUNCH -clock_fall -add_delay [get_ports {AD9361_P0_D[*]}]
set_multicycle_path 0 -setup -end -rise_from [get_clocks RX_LAUNCH] -rise_to [get_clocks AD9361_DATACLK]
set_multicycle_path 0 -setup -end -fall_from [get_clocks RX_LAUNCH] -fall_to [get_clocks AD9361_DATACLK]
# Explicitly retain the tool's default hold multiplier (0). The intended
# source-synchronous DDR model captures the same-edge launch and checks the
# following opposite-edge data change. Verify edge relationships in reports;
# +/-0.5 ns remains a teaching assumption requiring board confirmation.
set_multicycle_path 0 -hold -end -rise_from [get_clocks RX_LAUNCH] -rise_to [get_clocks AD9361_DATACLK]
set_multicycle_path 0 -hold -end -fall_from [get_clocks RX_LAUNCH] -fall_to [get_clocks AD9361_DATACLK]
set_input_delay 0.500 -max -clock AD9361_DATACLK [get_ports AD9361_RX_FRAME]
set_input_delay -0.500 -min -clock AD9361_DATACLK [get_ports AD9361_RX_FRAME]
set_input_delay 0.500 -max -clock AD9361_DATACLK -clock_fall -add_delay [get_ports AD9361_RX_FRAME]
set_input_delay -0.500 -min -clock AD9361_DATACLK -clock_fall -add_delay [get_ports AD9361_RX_FRAME]
set_output_delay -clock clk2AD9361 -max 0.500 [get_ports {AD9361_P1_D[*] AD9361_TX_FRAME}]
set_output_delay -clock clk2AD9361 -min -0.500 [get_ports {AD9361_P1_D[*] AD9361_TX_FRAME}]
set_output_delay -clock clk2AD9361 -max 0.500 -clock_fall -add_delay [get_ports {AD9361_P1_D[*] AD9361_TX_FRAME}]
set_output_delay -clock clk2AD9361 -min -0.500 -clock_fall -add_delay [get_ports {AD9361_P1_D[*] AD9361_TX_FRAME}]
