set_property PACKAGE_PIN M19 [get_ports PL_CLK_100MHz]
set_property IOSTANDARD LVCMOS33 [get_ports PL_CLK_100MHz]
create_clock -name PL_CLK_100MHz -period 10.000 [get_ports PL_CLK_100MHz]

set_property PACKAGE_PIN K15 [get_ports {LS_DAC1_DB[13]}]
set_property PACKAGE_PIN J15 [get_ports {LS_DAC1_DB[12]}]
set_property PACKAGE_PIN K19 [get_ports {LS_DAC1_DB[11]}]
set_property PACKAGE_PIN K20 [get_ports {LS_DAC1_DB[10]}]
set_property PACKAGE_PIN D15 [get_ports {LS_DAC1_DB[9]}]
set_property PACKAGE_PIN E15 [get_ports {LS_DAC1_DB[8]}]
set_property PACKAGE_PIN E19 [get_ports {LS_DAC1_DB[7]}]
set_property PACKAGE_PIN E20 [get_ports {LS_DAC1_DB[6]}]
set_property PACKAGE_PIN D16 [get_ports {LS_DAC1_DB[5]}]
set_property PACKAGE_PIN D17 [get_ports {LS_DAC1_DB[4]}]
set_property PACKAGE_PIN H19 [get_ports {LS_DAC1_DB[3]}]
set_property PACKAGE_PIN H20 [get_ports {LS_DAC1_DB[2]}]
set_property PACKAGE_PIN F17 [get_ports {LS_DAC1_DB[1]}]
set_property PACKAGE_PIN G17 [get_ports {LS_DAC1_DB[0]}]
set_property PACKAGE_PIN G16 [get_ports LS_DAC1_WRT]
set_property PACKAGE_PIN G15 [get_ports LS_DAC1_CLK]

set_property PACKAGE_PIN W8 [get_ports {LS_DAC2_DB[13]}]
set_property PACKAGE_PIN V8 [get_ports {LS_DAC2_DB[12]}]
set_property PACKAGE_PIN U10 [get_ports {LS_DAC2_DB[11]}]
set_property PACKAGE_PIN U9 [get_ports {LS_DAC2_DB[10]}]
set_property PACKAGE_PIN AB11 [get_ports {LS_DAC2_DB[9]}]
set_property PACKAGE_PIN AA11 [get_ports {LS_DAC2_DB[8]}]
set_property PACKAGE_PIN AB10 [get_ports {LS_DAC2_DB[7]}]
set_property PACKAGE_PIN AB9 [get_ports {LS_DAC2_DB[6]}]
set_property PACKAGE_PIN W6 [get_ports {LS_DAC2_DB[5]}]
set_property PACKAGE_PIN W5 [get_ports {LS_DAC2_DB[4]}]
set_property PACKAGE_PIN AA4 [get_ports {LS_DAC2_DB[3]}]
set_property PACKAGE_PIN Y4 [get_ports {LS_DAC2_DB[2]}]
set_property PACKAGE_PIN V5 [get_ports {LS_DAC2_DB[1]}]
set_property PACKAGE_PIN V4 [get_ports {LS_DAC2_DB[0]}]
set_property PACKAGE_PIN Y5 [get_ports LS_DAC2_WRT]
set_property PACKAGE_PIN V7 [get_ports LS_DAC2_CLK]
set_property PACKAGE_PIN W7 [get_ports LS_DAC_MODE]

set_property IOSTANDARD LVCMOS33 [get_ports {LS_DAC1_DB[*]}]
set_property IOSTANDARD LVCMOS33 [get_ports {LS_DAC2_DB[*]}]
set_property IOSTANDARD LVCMOS33 [get_ports {LS_DAC1_CLK LS_DAC2_CLK LS_DAC1_WRT LS_DAC2_WRT LS_DAC_MODE}]

set_property PACKAGE_PIN L22  [get_ports GPIO_TH1]
set_property PACKAGE_PIN AA12 [get_ports GPIO_TH2]
set_property PACKAGE_PIN AB12 [get_ports GPIO_TH3]
set_property PACKAGE_PIN D21  [get_ports GPIO_TH4]
set_property IOSTANDARD LVCMOS33 [get_ports {GPIO_TH1 GPIO_TH2 GPIO_TH3 GPIO_TH4}]

create_generated_clock -name dac1_clk -source [get_pins Inst_clock_32d768M/clk_out1] -divide_by 1 [get_ports LS_DAC1_CLK]
create_generated_clock -name dac2_clk -source [get_pins Inst_clock_32d768M/clk_out1] -divide_by 1 [get_ports LS_DAC2_CLK]
create_generated_clock -name dac1_wrt -source [get_pins Inst_clock_32d768M/clk_out1] -divide_by 1 -invert [get_ports LS_DAC1_WRT]
create_generated_clock -name dac2_wrt -source [get_pins Inst_clock_32d768M/clk_out1] -divide_by 1 [get_ports LS_DAC2_WRT]
set_output_delay -clock dac1_wrt -max 2.500 [get_ports {LS_DAC1_DB[*]}]
set_output_delay -clock dac1_wrt -min -2.000 [get_ports {LS_DAC1_DB[*]}]
set_output_delay -clock dac2_wrt -max 2.500 [get_ports {LS_DAC2_DB[*]}]
set_output_delay -clock dac2_wrt -min -2.000 [get_ports {LS_DAC2_DB[*]}]
set_false_path -to [get_ports {GPIO_TH1 GPIO_TH2 GPIO_TH3 GPIO_TH4}]
